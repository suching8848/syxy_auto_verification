# 包含校园网密码，不要提交
auto_login_config.json

# 运行日志
logs/
*.log

# Python
__pycache__/
*.py[cod]

# 编辑器 / IDE 本地配置
.vscode/
.idea/

# PyInstaller 构建产物（spec 是构建配方，需要纳入版本管理）
dist/
*.spec
build/*
!build/CampusNet.spec
!build/auto_login.spec

# 打包用的图标资源需要提交
!assets/

# 发布包组装素材（说明书等随 RELEASE_v*.md 一起维护）
packaging/
# 但发布打包脚本必须入库：它负责只收白名单文件，防止把运行目录里
# 用户自己的 auto_login_config.json（含明文密码）和 logs/ 打进 zip 上传
!packaging/
packaging/*
!packaging/make_release_zip.py
!packaging/使用说明.txt
